# EduGame AI — benötigte Environment-Variablen
# Auf Railway unter Service → Variables setzen. Werte NICHT committen.

# --- Build-Zeit (NEXT_PUBLIC_*) --------------------------------------------
# Werden von Next in das Client-Bundle eingebacken → müssen beim `docker build`
# vorhanden sein. Railway stellt Service-Variablen automatisch als Build-Args
# bereit; das Dockerfile deklariert sie als ARG.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Laufzeit (Server-Secrets) ---------------------------------------------
# Nur serverseitig gelesen, nicht ins Image gebacken.
ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
